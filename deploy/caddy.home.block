# BEGIN TEMP MAIL
temp-mail.serwerbb.win {
  encode zstd gzip
  tls {
    ca https://acme-v02.api.letsencrypt.org/directory
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    -Server
  }
  request_body {
    max_size 1KB
  }
  reverse_proxy temp-mail-web:3000 {
    header_up X-Real-IP {remote_host}
    header_up Host temp-mail.serwerbb.win
    header_up X-Forwarded-Host temp-mail.serwerbb.win
    header_up X-Forwarded-Proto https
  }
}
# END TEMP MAIL
